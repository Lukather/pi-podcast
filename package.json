{
  "name": "pi-podcast",
  "version": "0.1.2",
  "description": "Pocket Casts podcast player for pi — browse subscriptions, search, and play episodes in mpv.",
  "author": "Lorenzo Strambi <mail@lukather.net>",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "podcast",
    "pocket-casts",
    "mpv"
  ],
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/harness.ts --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./podcast.ts"
    ]
  },
  "files": [
    "podcast.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lukather/pi-podcast.git"
  },
  "homepage": "https://github.com/Lukather/pi-podcast#readme",
  "bugs": {
    "url": "https://github.com/Lukather/pi-podcast/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
